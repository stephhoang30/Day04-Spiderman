{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "10 case do nhóm tự viết",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_verify_explicit_sources",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm chứng claim 'OpenAI đã công bố mô hình mới' bằng các link https://openai.com/news/ và https://www.reuters.com/.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "verify_sources",
            "args": {
              "claim": "OpenAI đã công bố mô hình mới",
              "urls": ["https://openai.com/news/", "https://www.reuters.com/"]
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_verify_explicit_sources",
        "difficulty": "medium",
        "what_it_tests": "Agent phải chọn verify_sources khi claim và URL đã được cung cấp"
      }
    },
    {
      "id": "G02_timeline_limit",
      "phase": "B",
      "suite": "group",
      "query": "Lấy 3 tweet mới nhất của Elon Musk",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "elonmusk",
              "limit": 3
            }
          }
        ]
      },
      "metadata": {
        "skill": "arg_limit_timeline",
        "difficulty": "easy",
        "what_it_tests": "Agent phải map tên Elon Musk thành handle elonmusk và giữ limit=3"
      }
    },
    {
      "id": "G03_clarify_missing_url",
      "phase": "B",
      "suite": "group",
      "query": "Tóm tắt bài viết này giúp mình",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_url",
        "difficulty": "medium",
        "what_it_tests": "Agent phải hỏi lại khi thiếu URL để đọc bài"
      }
    },
    {
      "id": "G04_no_tool_meta",
      "phase": "B",
      "suite": "group",
      "query": "Bạn là gì và làm được gì?",
      "failure_type": "unnecessary_tool",
      "expect": {
        "no_tool": true
      },
      "metadata": {
        "skill": "no_tool_meta",
        "difficulty": "easy",
        "what_it_tests": "Agent không nên gọi tool cho câu hỏi meta"
      }
    },
    {
      "id": "G05_confirm_before_send",
      "phase": "B",
      "suite": "group",
      "query": "Đăng bản tin này lên Telegram cho mình",
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "confirm_before_send",
        "difficulty": "medium",
        "what_it_tests": "Agent phải xác nhận trước hành động gửi nội dung"
      }
    },
    {
      "id": "G06_multiturn_news_shift",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tin AI hôm nay có gì?"
        },
        {
          "role": "user",
          "content": "Còn về robotics thì sao?"
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "robotics",
              "topic": "news",
              "timeframe": "day"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_news_shift",
        "difficulty": "hard",
        "what_it_tests": "Agent phải hiểu lượt cuối là chuyển sang robotics và vẫn dùng lookup news"
      }
    },
    {
      "id": "G07_multiturn_timeline_correction",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tweet mới nhất của Sam Altman"
        },
        {
          "role": "user",
          "content": "À nhầm, của Andrej Karpathy"
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "karpathy"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_correction",
        "difficulty": "hard",
        "what_it_tests": "Agent phải sửa tên người ở lượt sau và dùng handle karpathy"
      }
    },
    {
      "id": "G08_multiturn_clarify_then_url",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tóm tắt bài này hộ mình"
        },
        {
          "role": "user",
          "content": "Link là https://anthropic.com/news/claude"
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "fetch",
            "args": {
              "url": "https://anthropic.com/news/claude"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_clarify_url",
        "difficulty": "hard",
        "what_it_tests": "Agent phải dùng link được cung cấp ở lượt sau để đọc bài"
      }
    },
    {
      "id": "G09_multiturn_verify_sources",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Mình muốn kiểm chứng claim 'Anthropic đã công bố Claude mới'."
        },
        {
          "role": "user",
          "content": "Dùng hai link này: https://www.anthropic.com/news và https://www.bbc.com/news"
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "verify_sources",
            "args": {
              "claim": "Anthropic đã công bố Claude mới",
              "urls": ["https://www.anthropic.com/news", "https://www.bbc.com/news"]
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_verify_sources",
        "difficulty": "medium",
        "what_it_tests": "Agent phải mang claim từ lượt trước và dùng URL ở lượt sau"
      }
    },
    {
      "id": "G10_multiturn_boundary",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Đăng một thông báo lên Telegram"
        },
        {
          "role": "user",
          "content": "Đúng rồi, cho mình xác nhận trước"
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_boundary",
